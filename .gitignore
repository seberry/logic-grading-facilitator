# --- Global Ignores (Any folder) ---
*.pdf
*.jpg
*.jpeg
*.png
*.zip

# --- Folder Specific ---
data/
data_archive/
__pycache__/
working/*

# ---- Python / tooling ----
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
.dist/
.build/
.env
.venv
venv/
env/
.idea/
.vscode/
*.log

# ---- OS cruft ----
.DS_Store
Thumbs.db

# ---- App data (FERPA-sensitive) ----
data/raw_scans/
data/auto_grouped/
data/grades/
data/name_review_cache/
data/debug/
data_archive/

# Roster contains student names and IDs; keep a fake/sample in docs instead
data/roster.csv

# Debug artifacts / overlays / crops
debug_output/
debug_output_segment_all/

# ---- Optional: ignore any local scratch notebooks, etc. ----
*.ipynb_checkpoints
*.tmp

# optional: LM Studio cache dirs, model downloads, venv, etc.
lmstudio/
models/
.aider*
vendor/deduct-master/
tools/deduct_checker_cli/target/
pytest-cache-files-*/

# Allow .gitkeep so working/ dir is preserved in repo
!working/.gitkeep